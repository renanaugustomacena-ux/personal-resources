dev tun
persist-tun
persist-key
cipher AES-128-CBC
data-ciphers AES-128-GCM
auth SHA256
tls-client
client
resolv-retry infinite
remote 45.151.15.58 1194 udp4
auth-user-pass
pkcs12 pfSense-UDP4-1194-francescav.p12
tls-auth pfSense-UDP4-1194-francescav-tls.key 1
remote-cert-tls server
# tutto il traffico sulla rete OpenVpn   #
redirect-gateway def1
# usa il DNS della VPN per accesso RD #
dhcp-option DNS 192.168.1.146
# misura di sicurezza per blocco DNS   #
--block-outside-dns
